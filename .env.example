# ============================================================
# One23 backend — LOCAL DEVELOPMENT settings
# Copy this file to .env (same folder) and fill in your values:
#     cp .env.example .env
# .env is git-ignored. NEVER commit real passwords or secrets.
#
# In PRODUCTION there is no .env file: set these same names as
# environment variables on your hosting platform, plus
#     SPRING_PROFILES_ACTIVE=prod
# ============================================================

# ---- Database (PostgreSQL, e.g. Supabase) ----
ONE23_DATABASE_URL=jdbc:postgresql://localhost:5432/one23
ONE23_DATABASE_USERNAME=postgres
ONE23_DATABASE_PASSWORD=change-me

# ---- JWT ----
# At least 32 characters. Generate one with:  openssl rand -base64 48
# Use a DIFFERENT secret in production.
JWT_SECRET=

# ---- CORS (which frontend URLs may call the API and open /ws) ----
# Local default (if unset): any localhost port.
# Production: your exact frontend URL, no wildcard, no trailing slash,
#   e.g. https://one23.vercel.app
# ONE23_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- Welcome email link ----
# Production: https://<your-frontend>/login
# ONE23_FRONTEND_LOGIN_URL=http://localhost:5173/login

# ---- Welcome email (Gmail SMTP) — optional ----
# Use a Gmail App Password (myaccount.google.com/apppasswords), not your normal password.
# ONE23_MAIL_HOST=smtp.gmail.com
# ONE23_MAIL_PORT=587
# ONE23_MAIL_USERNAME=your-address@gmail.com
# ONE23_MAIL_PASSWORD=your-16-char-app-password

# ---- Login rate limiting — optional (defaults shown) ----
# ONE23_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# ONE23_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
